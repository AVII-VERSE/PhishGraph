APP_ENV=development
APP_NAME=PhishGraph
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=

DATABASE_URL=sqlite+aiosqlite:///./phishgraph.db
# For PostgreSQL in Docker / production:
# DATABASE_URL=postgresql+asyncpg://phishgraph:phishgraph@postgres:5432/phishgraph

REDIS_URL=
# For Redis in Docker / production:
# REDIS_URL=redis://redis:6379/0

VIRUSTOTAL_API_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
ABUSEIPDB_API_KEY=

MAX_REDIRECTS=10
HTTP_TIMEOUT_SECONDS=8
MAX_RESPONSE_BYTES=1048576

ENABLE_QR_SCAN=true
ENABLE_WATCHLIST=true
ENABLE_PDF_REPORTS=true
